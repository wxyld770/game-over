#!/usr/bin/env bash
set -euo pipefail
umask 022

[[ "${EUID}" -eq 0 ]] || { echo 'Run as root via the restricted sudo rule.' >&2; exit 2; }

[[ $# -eq 2 ]] || { echo 'Usage: deploy-game-over COMMIT_SHA SHA256' >&2; exit 2; }
commit_sha="$1"
expected_digest="$2"
[[ "${commit_sha}" =~ ^[0-9a-f]{40}$ ]] || exit 2
[[ "${expected_digest}" =~ ^[0-9a-f]{64}$ ]] || exit 2

incoming="/var/lib/game-over-deploy/incoming/${commit_sha}"
bundle="${incoming}/release.tar.gz"
releases=/opt/game-over/releases
active=/opt/game-over/app
service=game-over.service
node_bin=/opt/game-over/node/bin
dependency_user=nobody

[[ -d "${incoming}" && ! -L "${incoming}" ]] || exit 2
[[ -f "${bundle}" && ! -L "${bundle}" ]] || exit 2
[[ "$(sha256sum "${bundle}" | awk '{print $1}')" == "${expected_digest}" ]] || {
  echo 'Release checksum mismatch.' >&2
  exit 1
}
[[ -d "${releases}" && ! -L "${releases}" ]] || exit 2
[[ -L "${active}" ]] || { echo 'Active release link is missing.' >&2; exit 2; }

previous="$(readlink -f "${active}")"
[[ "${previous}" == "${releases}/"* && -d "${previous}" ]] || exit 2
release="${releases}/${commit_sha}"

if [[ ! -d "${release}" ]]; then
  staging="$(mktemp -d "${releases}/.release.XXXXXXXX")"
  trap 'rm -rf -- "${staging}"' EXIT
  python3 - "${bundle}" "${staging}" <<'PY'
import pathlib
import sys
import tarfile

bundle, destination = sys.argv[1:]
allowed = {
    'server.js', 'doudizhu-server.js', 'jump-leaderboard.js', 'match3-leaderboard.js',
    'jump-redis-store.js', 'package.json', 'package-lock.json',
    'public/app.js', 'public/jump-rules.js', 'public/match3-rules.js', 'public/favicon.svg', 'public/index.html',
    'public/styles.css', 'public/hub.html',
    'public/games/doudizhu.html', 'public/games/sudoku.html',
    'public/games/minesweeper.html', 'public/games/spider.html',
    'public/games/jump.html', 'public/games/match3.html',
}
with tarfile.open(bundle, 'r:gz') as archive:
    members = archive.getmembers()
    if {member.name for member in members} != allowed or len(members) != len(allowed):
        raise SystemExit('Unexpected release file list')
    if any(not member.isfile() or member.size > 2_000_000 for member in members):
        raise SystemExit('Invalid release file type or size')
    if sum(member.size for member in members) > 10_000_000:
        raise SystemExit('Release too large')
    for member in members:
        target = pathlib.Path(destination, member.name)
        target.parent.mkdir(parents=True, exist_ok=True)
        with archive.extractfile(member) as source, target.open('xb') as output:
            while True:
                chunk = source.read(64 * 1024)
                if not chunk:
                    break
                output.write(chunk)
        target.chmod(0o644)
PY
  chmod 0755 "${staging}" "${staging}/public"
  "${node_bin}/node" --check "${staging}/server.js"
  "${node_bin}/node" --check "${staging}/doudizhu-server.js"
  "${node_bin}/node" --check "${staging}/jump-leaderboard.js"
  "${node_bin}/node" --check "${staging}/match3-leaderboard.js"
  "${node_bin}/node" --check "${staging}/jump-redis-store.js"
  "${node_bin}/node" --check "${staging}/public/app.js"
  "${node_bin}/node" --check "${staging}/public/jump-rules.js"
  "${node_bin}/node" --check "${staging}/public/match3-rules.js"

  [[ -x "${node_bin}/npm" && -x /usr/sbin/runuser && -x /usr/bin/timeout ]] || {
    echo 'The Node/npm toolchain or restricted install runtime is missing.' >&2
    exit 2
  }
  dependency_group="$(id -gn "${dependency_user}")"
  dependency_cache="${staging}/.npm-cache"
  install -d -m 0755 -o "${dependency_user}" -g "${dependency_group}" "${staging}/node_modules"
  install -d -m 0700 -o "${dependency_user}" -g "${dependency_group}" "${dependency_cache}"
  (
    cd "${staging}"
    /usr/bin/timeout --signal=TERM --kill-after=5s 180s \
      /usr/sbin/runuser -u "${dependency_user}" -- /usr/bin/env -i \
      PATH="${node_bin}:/usr/bin:/bin" \
      "${node_bin}/npm" --prefix "${staging}" --cache "${dependency_cache}" \
      --userconfig=/dev/null --globalconfig="${staging}/.npm-globalrc" \
      ci --omit=dev --ignore-scripts --no-audit --no-fund --engine-strict \
      --registry=https://registry.npmjs.org --strict-ssl=true --fetch-retries=1 --fetch-timeout=30000
    /usr/sbin/runuser -u "${dependency_user}" -- /usr/bin/env -i \
      PATH="${node_bin}:/usr/bin:/bin" \
      "${node_bin}/node" -e 'require(process.argv[1] + "/node_modules/redis")' "${staging}"
  )
  rm -rf -- "${dependency_cache}"
  chown -R root:root "${staging}"
  mv -T -- "${staging}" "${release}"
  trap - EXIT
fi

same_contents=true
for file in server.js doudizhu-server.js jump-leaderboard.js match3-leaderboard.js jump-redis-store.js package.json package-lock.json public/app.js public/jump-rules.js public/match3-rules.js public/favicon.svg public/index.html public/styles.css public/hub.html public/games/doudizhu.html public/games/sudoku.html public/games/minesweeper.html public/games/spider.html public/games/jump.html public/games/match3.html; do
  if ! cmp -s -- "${previous}/${file}" "${release}/${file}"; then
    same_contents=false
    break
  fi
done

application_healthy() {
  systemctl is-active --quiet "${service}" || return 1
  curl --fail --silent --max-time 2 \
    http://127.0.0.1:8889/api/health \
    | python3 -c 'import json,sys; assert json.load(sys.stdin)["ok"] is True' 2>/dev/null || return 1
  curl --fail --silent --max-time 5 \
    http://127.0.0.1:8889/api/jump/leaderboard \
    | python3 -c 'import json,sys; value=json.load(sys.stdin); assert isinstance(value,dict) and isinstance(value.get("entries"),list)' 2>/dev/null || return 1
  curl --fail --silent --max-time 5 \
    http://127.0.0.1:8889/api/match3/leaderboard \
    | python3 -c 'import json,sys; value=json.load(sys.stdin); assert isinstance(value,dict) and isinstance(value.get("entries"),list)' 2>/dev/null
}

next_link="${active}.next"
[[ ! -e "${next_link}" && ! -L "${next_link}" ]] || exit 2
ln -s -- "${release}" "${next_link}"
mv -Tf -- "${next_link}" "${active}"

if [[ "${same_contents}" == true ]] && application_healthy; then
  printf 'Activated %s; application files are unchanged, so no restart was needed.\n' "${commit_sha}"
  exit 0
fi

health_ok=false
if systemctl restart "${service}"; then
  for _ in {1..12}; do
    if application_healthy; then
      health_ok=true
      break
    fi
    sleep 1
  done
fi

if [[ "${health_ok}" != true ]]; then
  echo 'Health check failed; restoring previous release.' >&2
  ln -s -- "${previous}" "${next_link}"
  mv -Tf -- "${next_link}" "${active}"
  systemctl restart "${service}" || true
  exit 1
fi

printf 'Activated %s\n' "${commit_sha}"
